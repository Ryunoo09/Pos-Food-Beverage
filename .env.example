# Copy ke .env lalu isi nilainya. Jangan commit .env.
# Backend membaca .env otomatis (cari di current dir lalu parent);
# environment variable OS selalu menang atas nilai di file ini.

# App
APP_ENV=development
PORT=8080

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pos_food_db
DB_USER=postgres
DB_PASSWORD=postgres
# Opsional. Bila diisi, menimpa DB_* di atas. JANGAN diisi saat pakai docker-compose,
# karena DB_HOST container harus tetap "db".
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pos_food_db

# Backup (dipakai plan 09)
BACKUP_DIR=/backups
BACKUP_ENCRYPTION_KEY=changeme32charsmin
